{
    "version": 4,
    "configurations": [
        {
            "name": "STM32F103",
            "compilerPath": "",
            "cStandard": "c99",
            "cppStandard": "c++11",
            "intelliSenseMode": "windows-gcc-arm",
            "includePath": [
                "${workspaceFolder}/firmware/cmsis/core",
                "${workspaceFolder}/firmware/cmsis/device",
                "${workspaceFolder}/firmware/driver/inc",
                "${workspaceFolder}/**"
            ],
            "defines": [
                "STM32F10X_MD",
                "USE_STDPERIPH_DRIVER"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/firmware/driver/src",
                    "${workspaceFolder}/firmware/cmsis",
                    "${workspaceFolder}/**"
                ]
            }
        }
    ]
}
